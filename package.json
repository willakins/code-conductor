{
  "name": "code-conductor",
  "version": "1.0.0",
  "description": "A self-hosted engineering operations bot for PR reviews, testing, deployments, and production health.",
  "main": "index.js",
  "scripts": {
    "dev": "node src/app.js",
    "start": "bash scripts/runtime/start.sh",
    "start:long": "bash scripts/runtime/start_long.sh",
    "start:app": "node src/app.js",
    "stop": "bash scripts/runtime/stop.sh",
    "stop:long": "bash scripts/runtime/stop_long.sh",
    "stop:long:all": "bash scripts/runtime/stop_long_all.sh",
    "test": "node --test",
    "previews": "node docs/assets/previews/build.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willakins/code-conductor.git"
  },
  "keywords": [
    "chatops",
    "devops",
    "slack-bot",
    "github",
    "pull-requests",
    "deployment-automation",
    "monitoring",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/willakins/code-conductor/issues"
  },
  "homepage": "https://github.com/willakins/code-conductor#readme",
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "pg": "^8.18.0"
  }
}
